[Unit]
Description=Home Assistant Wyoming Pynab Button Bridge
After=network.target nabd.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pynab
EnvironmentFile=-/opt/pynab/wyoming/wyoming.conf
ExecStart=/opt/pynab/venv/bin/python3 /opt/pynab/wyoming/wyoming_button_bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
