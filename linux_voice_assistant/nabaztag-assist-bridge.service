[Unit]
Description=Home Assistant Assist State to Nabaztag Bridge
After=network-online.target nabd.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pynab
EnvironmentFile=-/opt/pynab/linux_voice_assistant/linux_voice_assistant.conf
ExecStart=/opt/pynab/venv/bin/python3 /opt/pynab/linux_voice_assistant/nabaztag_assist_bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
